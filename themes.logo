from pathlib import Path

html = r'''<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#080808">
  <title>KHANA GO — Food at Your Doorstep</title>
  <style>
    :root {
      --black: #080808;
      --orange: #ff7800;
      --gold: #ffb000;
      --white: #fffaf4;
      --muted: #b9b3ad;
    }

    * { box-sizing: border-box; }

    body {
      min-height: 100vh;
      margin: 0;
      display: grid;
      place-items: center;
      padding: 24px;
      color: var(--white);
      background:
        radial-gradient(ellipse at 50% 38%, rgba(255,120,0,.13), transparent 48%),
        var(--black);
      font-family: Inter, Arial, Helvetica, sans-serif;
    }

    .brand-card {
      width: min(100%, 980px);
      padding: clamp(24px, 5vw, 58px);
      text-align: center;
    }

    .symbol {
      width: min(100%, 390px);
      height: auto;
      margin: 0 auto 12px;
      display: block;
      filter: drop-shadow(0 12px 24px rgba(255, 120, 0, .18));
    }

    .wordmark {
      display: flex;
      justify-content: center;
      align-items: baseline;
      gap: .18em;
      flex-wrap: wrap;
      font-size: clamp(3rem, 10vw, 7rem);
      line-height: .95;
      font-weight: 950;
      letter-spacing: -.075em;
    }

    .wordmark .khana { color: var(--white); }
    .wordmark .go { color: var(--orange); }

    .swoosh {
      width: min(82%, 650px);
      height: 8px;
      margin: 24px auto 20px;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, var(--orange) 18%, var(--gold) 82%, transparent);
      transform: skewX(-24deg);
    }

    .tagline {
      margin: 0;
      color: var(--white);
      font-size: clamp(.72rem, 2vw, 1rem);
      font-weight: 750;
      letter-spacing: .34em;
    }

    .promise {
      margin: 16px 0 0;
      color: var(--muted);
      font-size: .82rem;
      letter-spacing: .12em;
    }

    @media (max-width: 480px) {
      .brand-card { padding-inline: 8px; }
      .tagline { letter-spacing: .18em; }
      .promise { font-size: .72rem; }
    }

    @media (prefers-reduced-motion: no-preference) {
      .symbol { animation: arrive .8s ease-out both; }
      @keyframes arrive {
        from { opacity: 0; transform: translateY(12px) scale(.96); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }
    }
  </style>
</head>
<body>
  <main class="brand-card" aria-label="Khana Go brand logo">
    <!-- Custom editable SVG illustration: chef hat, delivery box and scooter -->
    <svg class="symbol" viewBox="0 0 420 250" role="img"
         aria-labelledby="logo-title logo-desc" xmlns="http://www.w3.org/2000/svg">
      <title id="logo-title">Khana Go delivery symbol</title>
      <desc id="logo-desc">A chef hat above a fast orange delivery scooter carrying a food box.</desc>
      <defs>
        <linearGradient id="orange" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ffc04a"/>
          <stop offset=".48" stop-color="#ff8500"/>
          <stop offset="1" stop-color="#f04b00"/>
        </linearGradient>
        <linearGradient id="red" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#ff4b35"/>
          <stop offset="1" stop-color="#c91e12"/>
        </linearGradient>
      </defs>

      <!-- motion lines -->
      <path d="M28 126h72 M12 151h72 M44 176h42" stroke="#ff9a12"
            stroke-width="7" stroke-linecap="round" opacity=".9"/>

      <!-- chef hat -->
      <path d="M152 58c-18-4-28-20-20-36 8-17 30-18 41-4 9-22 42-22 51 1 20-3 34 14 27 32-3 8-10 13-19 14v18h-80z"
            fill="#fffaf4"/>
      <path d="M152 78h80v16h-80z" fill="#ff7800"/>

      <!-- delivery box -->
      <path d="M270 76l83 0 18 20-12 66h-96l-9-66z" fill="url(#red)"
            stroke="#ffad62" stroke-width="4" stroke-linejoin="round"/>
      <path d="M279 93h77" stroke="#ffb18a" stroke-width="4" opacity=".8"/>
      <path d="M300 125c0-10 8-18 18-18s18 8 18 18h-36z" fill="#fffaf4"/>
      <path d="M296 130h44" stroke="#fffaf4" stroke-width="5" stroke-linecap="round"/>
      <circle cx="318" cy="103" r="4" fill="#fffaf4"/>

      <!-- scooter wheels -->
      <circle cx="145" cy="199" r="31" fill="#111" stroke="#f7eee5" stroke-width="7"/>
      <circle cx="145" cy="199" r="11" fill="#ff9a12"/>
      <circle cx="331" cy="199" r="31" fill="#111" stroke="#f7eee5" stroke-width="7"/>
      <circle cx="331" cy="199" r="11" fill="#ff9a12"/>

      <!-- scooter body -->
      <path d="M145 193h58c18 0 28-12 34-29l14-39h42l-7 39c-4 23-21 42-48 42H145z"
            fill="url(#orange)" stroke="#ffbd4a" stroke-width="5" stroke-linejoin="round"/>
      <path d="M270 125h42l24 48h-60" fill="#ff8a00" stroke="#ffc04a" stroke-width="4"/>
      <path d="M302 122l23-23 17 2-9 28" fill="#fffaf4" stroke="#ff9a12" stroke-width="5"/>
      <path d="M332 99l24-14" stroke="#fffaf4" stroke-width="7" stroke-linecap="round"/>
      <path d="M357 84l20-12" stroke="#ffb000" stroke-width="5" stroke-linecap="round"/>

      <!-- rider -->
      <path d="M223 113c-3-22 10-41 30-46 18-5 36 7 40 26l-8 31-37 7z"
            fill="url(#red)" stroke="#ff6542" stroke-width="4"/>
      <circle cx="270" cy="43" r="25" fill="#f4b17d"/>
      <path d="M245 43c-3-25 15-39 37-35 17 3 25 16 23 29-15-8-33-7-49 4l-5 16z"
            fill="#ff352b"/>
      <path d="M246 34c15-19 40-21 59-5" fill="none" stroke="#ff7562" stroke-width="5" stroke-linecap="round"/>
      <path d="M280 46q8-8 15 0" fill="none" stroke="#241710" stroke-width="4" stroke-linecap="round"/>
      <path d="M282 61q10 8 19-2" fill="none" stroke="#241710" stroke-width="3" stroke-linecap="round"/>
      <path d="M250 84l-25 29 42 13 17-31" fill="url(#red)"/>
      <path d="M286 92l34 16 19-5" fill="none" stroke="#f4b17d" stroke-width="11" stroke-linecap="round"/>
      <path d="M338 102l18-17" fill="none" stroke="#f4b17d" stroke-width="9" stroke-linecap="round"/>
      <path d="M238 122l-5 40 48 0 10-37" fill="#242424"/>
      <path d="M233 161l-17 20 35 5" fill="none" stroke="#242424" stroke-width="13" stroke-linecap="round"/>
    </svg>

    <div class="wordmark">
      <span class="khana">KHANA</span>
      <span class="go">GO</span>
    </div>

    <div class="swoosh" aria-hidden="true"></div>
    <p class="tagline">FOOD AT YOUR DOORSTEP</p>
    <p class="promise">FAST <span style="color:#ff7800">•</span> FRESH <span style="color:#ff7800">•</span> DELICIOUS</p>
  </main>
</body>
</html>
'''

out = Path("/mnt/data/index.html")
out.write_text(html, encoding="utf-8")
print(f"Created {out}")
